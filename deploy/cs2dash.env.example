# cs2dash service environment — copy to /etc/cs2dash/cs2dash.env and `chmod 640`.
# Never commit the real file; it holds your password hash and Steam cookie.

# --- Authentication (required for internet exposure) ---
# Generate the hash with:  python3 server.py --hash-password
CS2DASH_AUTH_USER=admin
CS2DASH_AUTH_PASSWORD_HASH=pbkdf2_sha256$200000$REPLACE_ME$REPLACE_ME
# Session lifetime in seconds (default 30 days).
CS2DASH_SESSION_TTL=2592000
# Keep cookies HTTPS-only. Behind Caddy the browser uses HTTPS, so leave this on.
CS2DASH_COOKIE_SECURE=1

# --- Networking ---
# Bind to loopback only; Caddy proxies to it. Do NOT expose this port publicly.
CS2DASH_BIND=127.0.0.1

# --- Data location (point at the existing 5 GB database dir on the server) ---
CS2DASH_DATA_DIR=/var/lib/cs2dash

# --- Steam chart history (optional but recommended) ---
# Do not log or commit this value.
STEAM_COOKIE=REPLACE_WITH_STEAM_COOKIE
STEAM_MIN_INTERVAL=2.0
STEAM_HISTORY_FETCH_TIMEOUT=10

# --- Background market refresh ---
AUTO_MARKET_REFRESH=1
MARKET_REFRESH_INTERVAL_SECONDS=21600
DATA_TASK_RESUME_ENABLED=1

# --- Provider snapshot pricing ---
CSGOTRADER_PRICE_BASE=https://prices.csgotrader.app/latest
MARKET_SOURCE_PRIORITY=steam,csfloat,buff163,youpin,skinport
MARKET_BULK_SOURCE=any
